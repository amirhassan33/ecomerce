# Copiar este archivo como .env y completar los valores. No subir el .env al repositorio.

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB (usar ecomerceDB; ecomerceDB_test solo para correr `npm test`)
MONGO_DB_URI=
MONGO_DB_USER=
MONGO_DB_PASSWORD=
MONGO_DB_NAME=ecomerceDB

JWT_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_WEBHOOK_STRICT=false

# Correos (Resend)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_RECOVERY_SECRET=

# Imágenes (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
